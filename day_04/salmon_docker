# use Debian 12 instead of the outdated bullseye image
FROM debian:bookworm-slim

LABEL image.author.name="AlexaIschebeck"
LABEL image.author.email="alexa-kim.ischebeck@student.uni-tuebingen.de"

# Install dependencies, curl is needed to download Salmon
RUN apt-get update && apt-get install -y curl

# Download and install Salmon
# download and extract the complete Salmon distribution
RUN curl -L https://github.com/COMBINE-lab/salmon/releases/download/v1.5.2/salmon-1.5.2_linux_x86_64.tar.gz \
    -o salmon.tar.gz && \
    tar -xzf salmon.tar.gz && \
    mv salmon-1.5.2_linux_x86_64 /opt/salmon

# Set the PATH environment variable
# add Salmon's bin directory to PATH
ENV PATH="/opt/salmon/bin:${PATH}"

# tell Linux where Salmon's bundled libraries are located
ENV LD_LIBRARY_PATH="/opt/salmon/lib:${LD_LIBRARY_PATH}"
